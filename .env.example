# Backend Configuration
PROJECT_NAME="ParcelPilot AI Agent API"
ENVIRONMENT="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (Used at build/runtime)
